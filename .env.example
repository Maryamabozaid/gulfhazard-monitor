HOST=127.0.0.1
PORT=5173
DATA_DIR=./data
# Empty uses embedded PostgreSQL/PostGIS for a single local process.
DATABASE_URL=
DATA_PROFILE=research
CACHE_RESPONSES=1024
# REQUIRE_LOGIN defaults to true when DATABASE_URL is set.
# REQUIRE_LOGIN=true
# COOKIE_SECURE=true
# POSTGRES_PASSWORD= (needed by Docker Compose)
# Recent NOAA-20 fire coverage works without a key.
FIRMS_MAP_KEY=
FIRMS_PRODUCTS=VIIRS_NOAA20_NRT,MODIS_NRT
FIRMS_MAX_DAYS=30
CERULEAN_MAX_FEATURES=3000
# Public Cerulean collection normally accepts anonymous access.
CERULEAN_TOKEN=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
OPENAQ_API_KEY=
OPENSKY_ACCESS_TOKEN=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Optional server-side file paths or trusted HTTPS GeoJSON endpoints.
GEM_GEOJSON=
FLARING_GEOJSON=
AIS_DENSITY_GEOJSON=
INFRASTRUCTURE_GEOJSON=
INSAR_GEOJSON=
# Alert channels use server-selected recipients. Sign in to manage rules.
ALERT_WEBHOOK_URL=
SMTP_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Optional API-only development port. Point the frontend proxy here if you change it.
API_PORT=5174
