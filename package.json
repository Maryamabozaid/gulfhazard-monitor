{
  "name": "gulfhazard-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:backend": "node --env-file-if-exists=.env backend/index.mjs --api-only",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "node --env-file-if-exists=.env backend/index.mjs",
    "test": "npm --prefix backend test",
    "test:map": "node scripts/test-map.mjs"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "dependencies": {
    "@deck.gl/layers": "^9.2.0",
    "@deck.gl/mapbox": "^9.2.0",
    "@electric-sql/pglite": "0.6.0",
    "@electric-sql/pglite-postgis": "0.3.0",
    "@mapbox/shp-write": "^0.4.3",
    "@turf/turf": "^7.2.0",
    "chart.js": "^4.5.0",
    "csv-parse": "7.0.3",
    "express": "^5.1.0",
    "fast-png": "6.4.0",
    "geotiff": "3.0.5",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.552.0",
    "maplibre-gl": "6.19.0",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "supercluster": "^8.0.1",
    "zustand": "^5.0.8",
    "@turf/bbox": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/centroid": "7.4.0"
  }
